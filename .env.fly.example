# Fly.io Environment Configuration Template
# Copy to .env and configure via: fly secrets set KEY=value

APP_NAME="Samak Masjid"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://samak-masjid.fly.dev

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DATABASE_URL=

# Session & Cache
SESSION_DRIVER=database
CACHE_STORE=database

# Queue
QUEUE_CONNECTION=database

# Mail (configure as needed)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=samak-app
REVERB_APP_KEY=your-reverb-key
REVERB_APP_SECRET=your-reverb-secret
REVERB_HOST=samak-masjid.fly.dev
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# Vite (for frontend WebSocket connection)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
